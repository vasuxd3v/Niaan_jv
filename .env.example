# cp .env.example .env  and fill these in. .env is gitignored.

# Discord developer portal -> your app -> Bot -> Reset Token
token=

# Optional
prefix=q.
channel=

# Google service-account JSON on ONE line (cloud hosts).
# Locally you can skip this and put the same JSON in ./creds.json instead.
GOOGLE_CREDENTIALS=

# Optional, defaults to the existing sheet in index.js
SHEET_ID=

# Web dashboard — leave blank to disable it entirely
DASHBOARD_TOKEN=
PORT=3000
